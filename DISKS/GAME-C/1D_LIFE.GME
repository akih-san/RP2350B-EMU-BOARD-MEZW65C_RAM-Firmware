1.+++++++++++++++++++++++++++++++++++
2. 1D Life Game
3.   Cell life condition
4.    count four neighboring live cells
5.      barth : 2,3
6.      deth  : 0,1,3
7.  Ver 0.01 20250301 by skyriver
8.+++++++++++++++++++++++++++++++++++
90 W=64 L=&+1 M=L+W #=1000
100' init
110 I=0,W-1 L:I)=('(10))<5 @=I+1
120 ]
200' disp
210  / I=0,W-1
220  C="." ;=L:I) C="O"
230  $=C
240 @=I+1
250 ]
300' life decision I <- idx, C <- count
310  M:I)=L:I)
320  ;=L:I) ;=(C=1)+(C=2)+(C=4) M:I)=0
330  ;=L:I)=0 ;=(C=2)+(C=3) M:I)=1
340 ]
400' next gen
410 C=L:W-3)+L:W-2)+L:W-1)+L:0)+L:1)
420 I=0,W-1
430  R=I-3 ;=R<0 R=R+W
440  C=C-L:R)
450  R=I+2 ;=R>=W R=R-W
460  C=C+L:R)
470  !=300
480 @=I+1
490 I=0,W-1 L:I)=M:I) @=I+1
500 ]
1000. main
1010 @
1020  !=100
1030  J=1,100
1040   !=200 !=400 ""
1050  @=J+1
1060  /
1070 @=0
